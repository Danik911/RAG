nd allocation for upcoming project phases.\"\n\n# Key Features and Advantages\n\n- State Maintenance: Tracks document context and workflow stage, ensuring consistency across processes.", "mimetype": "text/plain", "start_char_idx": 61526, "end_char_idx": 63535, "metadata_seperator": "\n", "text_template": "[Excerpt from document]\n{metadata_str}\nExcerpt:\n-----\n{content}\n-----\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "99da6ef5-9aea-464e-8a31-d336fdb3ac67", "embedding": null, "metadata": {"file_path": "C:\\Users\\anteb\\PycharmProjects\\JupyterProject\\naive_rag\\data\\ai_articles\\AGENTIC RETRIEVAL-AUGMENTED GENERATION A SURVEY ON AGENTIC RAG.md", "file_name": "AGENTIC RETRIEVAL-AUGMENTED GENERATION A SURVEY ON AGENTIC RAG.md", "file_type": "text/markdown", "file_size": 104275, "creation_date": "2025-03-25", "last_modified_date": "2025-03-20", "document_title": "\"Agentic Retrieval-Augmented Generation: Principles, Architectures, Applications, and Future Directions in Dynamic AI Systems Across Healthcare, Finance, and Education\""}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "63cc26e7-3760-4de7-9cea-369ed82e58d6", "node_type": "4", "metadata": {"file_path": "C:\\Users\\anteb\\PycharmProjects\\JupyterProject\\naive_rag\\data\\ai_articles\\AGENTIC RETRIEVAL-AUGMENTED GENERATION A SURVEY ON AGENTIC RAG.md", "file_name": "AGENTIC RETRIEVAL-AUGMENTED GENERATION A SURVEY ON AGENTIC RAG.md", "file_type": "text/markdown", "file_size": 104275, "creation_date": "2025-03-25", "last_modified_date": "2025-03-20"}, "hash": "42831f3d26ca4cfa6d94fdd9504869cdd0ae1fd50debb205f921f3f248abd7cc", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "7f5cf46e-d25e-4946-9776-58d03251787f", "node_type": "1",