le of Jinshi.", "mimetype": "text/plain", "start_char_idx": 22085, "end_char_idx": 23556, "metadata_seperator": "\n", "text_template": "[Excerpt from document]\n{metadata_str}\nExcerpt:\n-----\n{content}\n-----\n", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "5b2103ef-dba1-4b22-b3e3-8b4cc83b5c59", "embedding": null, "metadata": {"file_path": "C:\\Users\\anteb\\PycharmProjects\\JupyterProject\\naive_rag\\data\\ai_articles\\AIstorian lets AI be a historian A KG-powered multi-agent system.md", "file_name": "AIstorian lets AI be a historian A KG-powered multi-agent system.md", "file_type": "text/markdown", "file_size": 27860, "creation_date": "2025-03-25", "last_modified_date": "2025-03-22", "document_title": "\"AIstorian: A Knowledge Graph-Driven Multi-Agent System for Accurate Biography Generation and Error Correction in Historical Research\""}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "86d6a30b-f854-412f-bc3d-7186c1cd0752", "node_type": "4", "metadata": {"file_path": "C:\\Users\\anteb\\PycharmProjects\\JupyterProject\\naive_rag\\data\\ai_articles\\AIstorian lets AI be a historian A KG-powered multi-agent system.md", "file_name": "AIstorian lets AI be a historian A KG-powered multi-agent system.md", "file_type": "text/markdown", "file_size": 27860, "creation_date": "2025-03-25", "last_modified_date": "2025-03-22"}, "hash": "13c05f2b3c34a30ab2b06b824e9bb3dd58f7f63367e6cdae60eac9f97a72c8ac", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "407ca6e7-9390-4797-9970-d1c28cb01f5c", "node_type": "1", "metadata": {"file_path": "C:\\Users\\anteb\\PycharmProjects\\JupyterProject\\naive_rag\\data\\ai_articles\\AIstorian lets AI be a historian A KG-powered multi-agent system.md", "file_name": "AIstor